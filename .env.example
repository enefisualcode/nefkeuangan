# Salin berkas ini menjadi ".env" saat menyiapkan project di komputer baru.
# Nilai aslinya TIDAK ikut ke GitHub - ambil dari Railway:
#   railway.app -> project grateful-wonder -> pilih service -> tab Variables
#   (klik ikon mata untuk menampilkan nilainya)

# Dari service "Postgres" -> Settings -> Networking -> Public Networking.
# Harus alamat publik (…proxy.rlwy.net), bukan yang .railway.internal,
# karena .railway.internal hanya bisa dijangkau dari dalam Railway.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway"

# Dari service "nefkeuangan" -> Variables. Kunci penanda sesi login.
# Kalau diganti, semua orang yang sedang login akan diminta masuk lagi.
AUTH_SECRET=""

# Dari service "nefkeuangan" -> Variables. Harus sama persis dengan nilai
# di service "worker", karena dipakai bot Telegram untuk memanggil API ini.
BOT_SERVICE_KEY=""

# Dari service "worker" atau "nefkeuangan" -> Variables.
# Hanya diperlukan bila ingin menguji fitur scan struk di komputer sendiri.
GEMINI_API_KEY=""
